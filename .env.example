# The MongoDB that docker compose starts. No user or password locally: in production,
# use a user with the readWrite role on this database only (see the README).
MONGODB_URI=mongodb://localhost:27017/catalog
PORT=3000
# The browser origins allowed to call the API, comma-separated, with their scheme. Empty: none.
CORS_ORIGINS=
# development (the default), test or production. Set it in the process environment, where your
# platform sets it: the logger in src/main.ts is created before .env is read.
# NODE_ENV=development

# NestJS Observe: `npx @nestjs/observe link` writes these. Empty, the SDK sends nothing.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
